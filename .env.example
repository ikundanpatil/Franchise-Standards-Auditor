# RocketRide connections — copy to `.env` and fill in, or let the platform
# populate it (`rocketride login`, or connecting from the VS Code extension).
# `.env` is gitignored; never commit real keys.

# Development connection: run / validate / iterate (use(), send/chat, monitors).
ROCKETRIDE_URI=
ROCKETRIDE_APIKEY=

# Deployment target: deploy.* / publishApp / submitApp / schedules / build logs.
ROCKETRIDE_DEPLOY_URI=
ROCKETRIDE_DEPLOY_APIKEY=

# ===========================================================================
# FranchiseGuard AI backend — environment template.
# Copy to `.env` and fill in.  `.env` is gitignored; never commit real secrets.
# The app loads `.env` automatically (python-dotenv) when it is present.
# ===========================================================================

# --- App -----------------------------------------------------------------
PROJECT_NAME="FranchiseGuard AI API"
ENVIRONMENT=local                     # local | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO                        # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false                        # true -> structured JSON logs (prod)

# --- Database ---------------------------------------------------------------
# Any SQLAlchemy URL. Examples:
#   local docker .... postgresql+psycopg2://franchiseguard:franchiseguard@localhost:5432/franchiseguard
#   Supabase (pooler) postgresql+psycopg2://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#   Supabase (direct) postgresql+psycopg2://postgres:<password>@db.<ref>.supabase.co:5432/postgres
DATABASE_URL=postgresql+psycopg2://franchiseguard:franchiseguard@localhost:5432/franchiseguard

# Set true when DATABASE_URL points at a transaction-mode pooler (Supabase :6543,
# PgBouncer). Disables SQLAlchemy pooling + server-side prepared statements.
DATABASE_USE_NULL_POOL=false
DATABASE_ECHO=false                   # log every SQL statement

# Create tables on startup if they do not exist (dev convenience only —
# production should run `alembic upgrade head`).
AUTO_CREATE_TABLES=false

# --- Auth / JWT ---------------------------------------------------------------
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=43200    # 30 days

# Seeded on first `python -m app.db.seed` run.
FIRST_ADMIN_EMAIL=admin@franchiseguard.ai
FIRST_ADMIN_PASSWORD=ChangeMe123!
FIRST_ADMIN_NAME="FranchiseGuard Admin"

# --- CORS -----------------------------------------------------------------
# Comma-separated origins allowed to call the API from a browser.
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://staging.rocketride.ai

# --- AI engine ---------------------------------------------------------------
# simulated -> deterministic mock engine (no keys, no cost).
# openai | anthropic | rocketride -> real engines (not implemented yet; see
#   app/services/ai/remote.py — wiring point for the vision pipeline).
AI_PROVIDER=simulated
AI_MODEL_VERSION=fg-vision-2.4
AI_SIMULATED_LATENCY_MS=350          # fake round-trip delay for the mock engine
# AI_API_KEY=                        # required once AI_PROVIDER is a real engine
# AI_API_BASE=

# --- RocketRide bridge (future) --------------------------------------------
# Populated when "Continue with RocketRide" is wired to exchange a shell
# assertion for a FranchiseGuard JWT. See app/routers/auth.py::rocketride_exchange.
# ROCKETRIDE_JWKS_URL=
# ROCKETRIDE_AUDIENCE=team_franchiseguard.franchiseguard-ai

# ===========================================================================
# External integrations  (app/integrations/) — every value is read from here;
# nothing is hardcoded. Leave a block blank to disable that integration; the
# API stays up and the relevant endpoints return 503 "integration_not_configured".
# ===========================================================================

# --- Google Gemini (complaint analysis + report narrative) ------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
# GEMINI_TIMEOUT_SECONDS=30

# --- Supabase (inspection-image storage + report persistence) --------------
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_INSPECTION_BUCKET=inspection-images
SUPABASE_REPORTS_TABLE=reports
# SUPABASE_TIMEOUT_SECONDS=30

# --- YOLO local vision service (NO API key) --------------------------------
# Install extras first:  pip install -r requirements-vision.txt
VISION_BACKEND=simulated              # simulated | yolo
YOLO_MODEL_PATH=yolov8n.pt            # path to a .pt model on disk
YOLO_CONFIDENCE_THRESHOLD=0.35
# YOLO_DEVICE=cpu                     # cpu | cuda:0 ; blank = auto
